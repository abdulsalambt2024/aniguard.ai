# Browser-safe Supabase configuration (publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional local-only mock mode. It is rejected in production builds.
VITE_USE_MOCK=false
VITE_USE_FIREBASE=false

# Demo-only admin UI toggle. Never grants real administrative permissions.
VITE_ENABLE_DEMO_ADMIN=false

# Server-only secrets: configure in Vercel Project Settings, never prefix with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
